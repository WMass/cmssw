<bin file="test_catch2_*.cc" name="testPhysicsToolsNanoAODTP">
  <use name="FWCore/TestProcessor"/>
  <use name="DataFormats/NanoAOD"/>
  <use name="DataFormats/PatCandidates"/>
  <use name="DataFormats/JetReco"/>
  <use name="catch2"/>
</bin>

<test name="test-fastsim-refiner-eras" command="python3 $$SCRAM_TEST_PATH/test_fastsim_refiner_eras.py"/>

<test name="test-btvNano-run" command="test-btvNano.sh"/>
<test name="test-btvNano-check" command="test-btvNano.py">
  <flags PRE_TEST="test-btvNano-run"/>
</test>

<library file="CvhGenMatchTestPlugins.cc" name="PhysicsToolsNanoAODCvhGenMatchTestPlugins">
  <use name="DataFormats/Common"/>
  <use name="DataFormats/HepMCCandidate"/>
  <use name="DataFormats/PatCandidates"/>
  <use name="DataFormats/TrackReco"/>
  <use name="FWCore/Framework"/>
  <use name="FWCore/ParameterSet"/>
  <use name="FWCore/Utilities"/>
